# ====================
# Java / Gradle
# ====================
*.class
*.jar
*.war
*.ear

/build/
/out/

.gradle
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

gradle.dev.properties
gradle.prod.properties

*.log
*.tmp
*.swp

# ====================
# Spring Boot
# ====================
# 민감한 설정 파일은 제외
application-dev.yml
application-prod.yml


# 공통 설정은 포함 (Git에 올라가도록 허용)
# application.yml 은 Git에 커밋 가능
# application.yml.example 은 명시적 예시로 커밋 추천
*.yaml
*.yml
!CI.yml
!CD.yml
!.coderabbit.yml
!application-test.yml
!prometheus.dev.yml
!prometheus.prod.yml
!.github/ISSUE_TEMPLATE/*.yml
# 부하 테스트 시나리오는 측정 재현의 근거라 추적한다 (2026-08-03 복원 — 전역 *.yml 차단의 예외)
!load-test/**/*.yml
!load-test/scenarios/*.yml
!load-test/.gitignore
!docker/docker-compose.bench.yml

.docker/init/init_role.sql

.env*

